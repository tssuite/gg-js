{
  "name": "@tssuite/gg-js",
  "version": "1.0.2",
  "description": "The gg command line, compiled to WebAssembly and runnable from Node via npx.",
  "keywords": [
    "gg",
    "cli",
    "dart",
    "wasm",
    "webassembly",
    "monorepo",
    "git",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.browser.js",
      "node": "./dist/index.node.js",
      "default": "./dist/index.js"
    },
    "./wasm": "./dist/bridge-wasm.wasm"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync-version": "dart run scripts/sync_version.dart",
    "build:dart": "dart run build.dart",
    "build:dart:debug": "dart run build.dart --debug",
    "build:ts": "tsc -p tsconfig.json && vite build && dart run scripts/dist.dart finalize",
    "build": "pnpm run clean && pnpm run sync-version && pnpm run build:dart && pnpm run build:ts",
    "clean": "dart run scripts/dist.dart clean",
    "test:dart": "dart test",
    "test:vitest": "vitest run --coverage",
    "test:node": "vitest run --project=node",
    "test:browser": "vitest run --project=browser",
    "test:coverage": "vitest run --coverage",
    "test": "pnpm run test:dart && pnpm run test:vitest && pnpm run lint && pnpm run format:check",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "pnpm run build && pnpm run test",
    "test:e2e": "vitest run --project=e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-plugin-jsdoc": "^64.0.2",
    "eslint-plugin-tsdoc": "^0.5.2",
    "globals": "^17.9.0",
    "jsdoc": "^4.0.5",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tssuite/gg-js.git"
  },
  "homepage": "https://github.com/tssuite/gg-js#readme",
  "bugs": {
    "url": "https://github.com/tssuite/gg-js/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Dr. Gabriel Gatzsche",
  "packageManager": "pnpm@11.5.3+sha512.7ac1c919341c213a34dc0d02afb7143c5c26ac26ee8c4782deea821b8ac64d2134a081fd8941dae6e29bbb48f58dfc2b7fbceeccc07cb2f09d219d342a4969ed",
  "bin": {
    "gg-js": "./dist/gg-js.mjs"
  }
}
